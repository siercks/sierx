    "test": "vitest run src",
    "test:browser": "playwright test",
    "routes": "node scripts/routes.mjs",
    "gate:routes": "node scripts/routes.mjs --check",
    "gate:bundle": "node scripts/bundle.mjs",
    "gate:offline-assets": "node scripts/offline-assets.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-virtual": "3.14.13",
    "lossless-json": "4.3.1",
    "markdown-it": "15.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/culori": "4.0.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "culori": "4.0.2",
    "html-validate": "11.16.1",
    "linkedom": "0.18.13",
    "postcss": "8.5.28",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
