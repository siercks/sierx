    "sx-text-sm": "0.6875rem",
    "sx-text-lg": "1.0625rem",
    "sx-text-xl": "0.8125rem",
    "sx-leading": "1.3",
    "sx-weight-strong": "700",
    "sx-radius": "0px",
    "sx-shadow-selected": "none",
    "sx-gutter": "8px",
    "sx-gap": "4px",
    "sx-pad": "5px 6px",
    "sx-cell-y": "3px",
    "sx-font-mono": "\"Sierx Mono\", ui-monospace, \"Cascadia Mono\", \"SF Mono\", Consolas, \"DejaVu Sans Mono\", monospace",
    "sx-font-symbols": "\"Sierx Symbols\"",
    "sx-font-ui": "\"Sierx Mono\", ui-monospace, \"Cascadia Mono\", \"SF Mono\", Consolas, \"DejaVu Sans Mono\", monospace",
    "sx-font-display": "var(--sx-font-ui)"
  },
  "private": {
    "tk-zebra": "#0b0b0b"
