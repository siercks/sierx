{
  "id": "ticker",
  "name": "Ticker",
  "scheme": "dark",
  "contrast": "normal",
  "summary": "A market-terminal reading of flow data sierx already logs: WIP, throughput, cycle-time percentiles and a Monte Carlo date above a dense table.",
  "tokens": {
    "background": "#000000",
    "foreground": "#f0f0f0",
    "card": "#000000",
    "card-foreground": "#f0f0f0",
    "muted": "#1b1b1b",
    "muted-foreground": "#a0a0a0",
    "accent": "#ffa733",
    "accent-foreground": "#000000",
    "border": "#5f5f5f",
    "input": "#ffa733",
    "ring": "#86bdff",
    "primary": "#ffa733",
    "primary-foreground": "#000000",
    "destructive": "#ff6a5a",
    "destructive-foreground": "#000000",
    "status-open": "#a0a0a0",
    "status-active": "#86bdff",
    "status-done": "#66d273",
    "status-cancelled": "#808080",
    "sx-chrome": "#121212",
    "sx-chrome-foreground": "#f0f0f0",
    "sx-chrome-muted": "#a0a0a0",
    "sx-panel": "#000000",
    "sx-rule": "#ffa733",
    "sx-hairline": "#1e1e1e",
    "sx-selected": "#3d2c00",
    "sx-selected-foreground": "#ffffff",
    "sx-selected-muted": "#d8c8a8",
