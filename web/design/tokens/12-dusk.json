{
  "id": "dusk",
  "name": "Low-glare dark",
  "scheme": "dark",
  "contrast": "normal",
  "summary": "Blue-grey surfaces instead of black, desaturated status hues and one warm amber accent for selection. Token-only.",
  "tokens": {
    "background": "#1b1e23",
    "foreground": "#dde1e6",
    "card": "#2b3038",
    "card-foreground": "#dde1e6",
    "muted": "#22262c",
    "muted-foreground": "#a3acb6",
    "accent": "#2b3038",
    "accent-foreground": "#dde1e6",
    "border": "#6b7482",
    "input": "#6b7482",
    "ring": "#e3b46c",
    "primary": "#e3b46c",
    "primary-foreground": "#1b1e23",
    "destructive": "#f08f80",
    "destructive-foreground": "#1b1e23",
    "status-open": "#a3acb6",
    "status-active": "#8cb8e8",
    "status-done": "#93c99f",
    "status-cancelled": "#8a929c",
    "sx-chrome": "#22262c",
    "sx-chrome-foreground": "#dde1e6",
    "sx-chrome-muted": "#a3acb6",
    "sx-panel": "#22262c",
    "sx-rule": "#363c46",
    "sx-hairline": "#363c46",
    "sx-selected": "#353b46",
    "sx-selected-foreground": "#f0f2f5",
    "sx-selected-muted": "#b8c0ca",
    "sx-shadow-selected": "0 0 0 1px var(--ring)",
    "sx-column": "#22262c",
    "sx-column-pad": "8px",
    "sx-detail-w": "340px",
    "sx-font-mono": "\"Sierx Mono\", ui-monospace, \"Cascadia Mono\", \"SF Mono\", Consolas, \"DejaVu Sans Mono\", monospace",
    "sx-font-symbols": "\"Sierx Symbols\"",
    "sx-font-ui": "system-ui, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "sx-font-display": "var(--sx-font-ui)"
  }
}
