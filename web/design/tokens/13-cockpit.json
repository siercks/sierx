{
  "id": "cockpit",
  "name": "Cockpit",
  "set": "curated",
  "scheme": "dark",
  "contrast": "normal",
  "summary": "Glass-cockpit display rules from FAA AC 25-11B. White is data, cyan is anything you can change, green is engaged, amber is caution and magenta is the current target. B612 was drawn for Airbus cockpit screens.",
  "tokens": {
    "background": "#0d1218",
    "foreground": "#e8eef2",
    "card": "#141b23",
    "card-foreground": "#e8eef2",
    "muted": "#1b242e",
    "muted-foreground": "#93a6b5",
    "accent": "#12303a",
    "accent-foreground": "#4fd8ec",
    "border": "#5d7486",
    "input": "#4fd8ec",
    "ring": "#ff5ce1",
    "primary": "#4fd8ec",
    "primary-foreground": "#061014",
    "destructive": "#ffb020",
    "destructive-foreground": "#0d1218",
    "status-open": "#e8eef2",
    "status-active": "#3ee07a",
    "status-done": "#93a6b5",
    "status-cancelled": "#627a8c",
    "sx-chrome": "#090d12",
    "sx-chrome-foreground": "#e8eef2",
    "sx-chrome-muted": "#93a6b5",
    "sx-panel": "#10161d",
    "sx-rule": "#2c3947",
    "sx-hairline": "#1f2933",
    "sx-selected": "#17202b",
    "sx-selected-foreground": "#ffffff",
    "sx-selected-muted": "#c3cfd9",
    "sx-weight-strong": "700",
    "sx-radius": "2px",
    "sx-shadow-selected": "0 0 0 2px #ff5ce1",
    "sx-font-mono": "\"Sierx Mono\", ui-monospace, \"Cascadia Mono\", \"SF Mono\", Consolas, \"DejaVu Sans Mono\", monospace",
    "sx-font-symbols": "\"Sierx Symbols\"",
    "sx-font-ui": "system-ui, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "sx-font-display": "var(--sx-font-ui)"
  }
}
