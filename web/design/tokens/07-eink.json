{
  "id": "eink",
  "name": "E-ink",
  "scheme": "light",
  "contrast": "high",
  "summary": "Black on white with no greys below 7:1, heavy rules and an inverted selection. Token-only.",
  "tokens": {
    "background": "#ffffff",
    "foreground": "#000000",
    "card": "#ffffff",
    "card-foreground": "#000000",
    "muted": "#ffffff",
    "muted-foreground": "#333333",
    "accent": "#000000",
    "accent-foreground": "#ffffff",
    "border": "#000000",
    "input": "#000000",
    "ring": "#0000cc",
    "primary": "#000000",
    "primary-foreground": "#ffffff",
    "destructive": "#a30000",
    "destructive-foreground": "#ffffff",
    "status-open": "#000000",
    "status-active": "#000000",
    "status-done": "#000000",
    "status-cancelled": "#000000",
    "sx-chrome": "#ffffff",
    "sx-chrome-foreground": "#000000",
    "sx-chrome-muted": "#333333",
    "sx-panel": "#ffffff",
    "sx-rule": "#000000",
    "sx-hairline": "#000000",
    "sx-selected": "#000000",
    "sx-selected-foreground": "#ffffff",
    "sx-selected-muted": "#e6e6e6",
    "sx-text": "1rem",
    "sx-text-sm": "0.8125rem",
    "sx-text-lg": "1.25rem",
    "sx-text-xl": "1.375rem",
    "sx-leading": "1.4",
    "sx-weight-strong": "700",
    "sx-radius": "0px",
    "sx-border-width": "2px",
    "sx-rule-width": "3px",
    "sx-focus-width": "3px",
    "sx-shadow-selected": "none",
    "sx-gutter": "24px",
    "sx-gap": "8px",
    "sx-pad": "10px 12px",
    "sx-cell-y": "9px",
    "sx-side-w": "220px",
    "sx-detail-w": "380px",
    "sx-font-mono": "\"Sierx Mono\", ui-monospace, \"Cascadia Mono\", \"SF Mono\", Consolas, \"DejaVu Sans Mono\", monospace",
    "sx-font-symbols": "\"Sierx Symbols\"",
    "sx-font-ui": "system-ui, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "sx-font-display": "var(--sx-font-ui)"
  }
}
