    "muted": "#eeeeee",
    "muted-foreground": "#4d4d4d",
    "accent": "#6b6b6b",
    "accent-foreground": "#ffffff",
    "border": "#707070",
    "input": "#707070",
    "ring": "#2f4fa8",
    "primary": "#2f4fa8",
    "primary-foreground": "#ffffff",
    "destructive": "#a00000",
    "destructive-foreground": "#ffffff",
    "status-open": "#4d4d4d",
    "status-active": "#0040a0",
    "status-done": "#006000",
    "status-cancelled": "#707070",
    "sx-chrome": "#dddddd",
    "sx-chrome-foreground": "#000000",
    "sx-chrome-muted": "#4d4d4d",
    "sx-panel": "#ffffff",
    "sx-rule": "#707070",
