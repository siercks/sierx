{
  "id": "civic",
  "name": "Civic",
  "scheme": "light",
  "contrast": "normal",
  "summary": "Modelled on public-service design systems like GOV.UK: a black header, underlined blue links, large type, worded tags and the yellow-and-black selection.",
  "tokens": {
    "background": "#ffffff",
    "foreground": "#0b0c0c",
