    "border": "#505a5f",
    "input": "#0b0c0c",
    "ring": "#0b0c0c",
    "primary": "#00703c",
    "primary-foreground": "#ffffff",
    "destructive": "#d4351c",
    "destructive-foreground": "#ffffff",
    "status-open": "#505a5f",
    "status-active": "#1d70b8",
    "status-done": "#00703c",
    "status-cancelled": "#6f777b",
    "sx-chrome": "#0b0c0c",
    "sx-chrome-foreground": "#ffffff",
    "sx-chrome-muted": "#ffffff",
    "sx-panel": "#ffffff",
    "sx-rule": "#b1b4b6",
    "sx-hairline": "#b1b4b6",
