{
  "id": "swiss",
  "name": "Swiss grid",
  "scheme": "light",
  "contrast": "normal",
  "summary": "Black rules, a strict column grid and big type for column names and counts. Selection inverts the card, and red appears only for trouble.",
  "tokens": {
    "background": "#ffffff",
    "foreground": "#111111",
    "card": "#ffffff",
    "card-foreground": "#111111",
    "muted": "#f0f0f0",
    "muted-foreground": "#555555",
    "accent": "#111111",
    "accent-foreground": "#ffffff",
    "border": "#767676",
    "input": "#111111",
    "ring": "#0047bb",
    "primary": "#111111",
    "primary-foreground": "#ffffff",
    "destructive": "#c8001e",
    "destructive-foreground": "#ffffff",
    "status-open": "#555555",
    "status-active": "#111111",
    "status-done": "#111111",
    "status-cancelled": "#767676",
    "sx-chrome": "#ffffff",
    "sx-chrome-foreground": "#111111",
    "sx-chrome-muted": "#555555",
    "sx-panel": "#ffffff",
    "sx-rule": "#111111",
    "sx-hairline": "#bbbbbb",
    "sx-selected": "#111111",
    "sx-selected-foreground": "#ffffff",
    "sx-selected-muted": "#d4d4d4",
    "sx-text": "0.875rem",
    "sx-text-lg": "1.25rem",
    "sx-text-xl": "2.5rem",
    "sx-leading": "1.35",
    "sx-weight-strong": "700",
    "sx-radius": "0px",
    "sx-rule-width": "2px",
    "sx-shadow-selected": "none",
    "sx-gutter": "28px",
    "sx-gap": "0px",
    "sx-pad": "10px 0 11px",
    "sx-font-mono": "\"Sierx Mono\", ui-monospace, \"Cascadia Mono\", \"SF Mono\", Consolas, \"DejaVu Sans Mono\", monospace",
    "sx-font-symbols": "\"Sierx Symbols\"",
    "sx-font-ui": "system-ui, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "sx-font-display": "var(--sx-font-ui)"
  }
}
