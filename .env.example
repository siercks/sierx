# sierx — environment reference
#
# All configuration is environment variables. There is no config file (SPEC §14.4).
# The server fails fast and loudly at startup on a missing or malformed value.
#
# THIS FILE IS COMMITTED TO A PUBLIC REPOSITORY (BUILD §3.7).
# It carries variable names, types, and non-identifying values only — NEVER a real
# hostname, bucket, address, or secret. Real values go in:
#   .env                     untracked, dev only            (in .gitignore)
#   /etc/sierx/sierx.env     mode 0600, staging and prod    (outside git)
# `make gate-notopology` fails the build if a real value reaches a tracked file.

# =========================================================================
# DEV QUICKSTART — copy this file to .env, then run the two openssl commands
# below. Every other value here is a working dev default. Nothing in phase 0
# requires an infrastructure decision.
# =========================================================================

# ---- core ----------------------------------------------------------------
SIERX_ENV=dev                      # dev | staging | prod
                                   # db-reset refuses unless dev
                                   # posix backup repos are rejected unless dev
DATABASE_URL=postgres://sierx:sierx@localhost:5432/sierx
SIERX_BASE_URL=http://localhost:8080
                                   # dev default. Staging and prod set this in the
                                   # host env file — it has no committable value

SIERX_SESSION_KEY=                 # GENERATE LOCALLY: openssl rand -base64 32
                                   # Never in git, never in a prompt

# ---- auth (SPEC §11.2) ---------------------------------------------------
SIERX_AUTH_MODE=local              # local | proxy — explicit, never inferred
SIERX_TRUSTED_PROXIES=             # REQUIRED in proxy mode only. CIDR allowlist; an
                                   # identity header from any other source IP is
                                   # rejected. Leave empty in local mode

# ---- backups (ADR-010, ADR-017) -----------------------------------------
# Two targets, two times. Dev exercises the harness; task 2.16 sets the real
# off-box target in the host env file. bootstrap-check rejects posix whenever
# SIERX_ENV is not dev, so this dev fixture cannot be deployed by accident.

SIERX_BACKUP_DRIVERS=pgbackrest,pgdump
                                   # Ordered list. Makefile targets never name a tool
PGBACKREST_REPO_TYPE=posix         # dev: posix | deployment: sftp (recommended) | s3
PGBACKREST_REPO_PATH=/var/lib/sierx/backup-repo
                                   # dev: a local path
                                   # deployment: <host>:/srv/pgbackrest/sierx — the
                                   # host goes in the host env file, never here
SIERX_DUMP_PATH=/var/lib/sierx/dumps

PGBACKREST_CIPHER_PASS=            # GENERATE LOCALLY: openssl rand -base64 48
                                   # Fixed at stanza-create; changing it later means a
                                   # new repository or stanza (ADR-010)

# S3-compatible repository, only when PGBACKREST_REPO_TYPE=s3. Host env file only.
# PGBACKREST_REPO_S3_ENDPOINT=
# PGBACKREST_REPO_S3_BUCKET=
# PGBACKREST_REPO_S3_REGION=
# PGBACKREST_REPO_S3_KEY=
# PGBACKREST_REPO_S3_KEY_SECRET=

# Optional second repository. The harness supports up to four from day one
# (ADR-010). A common shape after task 2.16 is fast sftp repo1 for restore speed
# plus cloud repo2 for survival; archive-push writes to both and archive-get
# searches both in priority order.
# PGBACKREST_REPO2_TYPE=
# PGBACKREST_REPO2_PATH=
# PGBACKREST_REPO2_CIPHER_PASS=
