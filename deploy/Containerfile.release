# Native binaries and certificate bundle from the matching hosted runner.
# scratch has no mutable distribution base or package installation.
FROM scratch
ARG TARGETARCH
COPY dist/sierx-${TARGETARCH} /usr/local/bin/sierx
COPY dist/sierxctl-${TARGETARCH} /usr/local/bin/sierxctl
COPY dist/ca-certificates-${TARGETARCH}.crt /etc/ssl/certs/ca-certificates.crt
COPY dist/runtime-${TARGETARCH}/assets /srv/sierx/assets
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/sierx"]
