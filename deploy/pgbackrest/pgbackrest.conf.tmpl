# pgbackrest.conf — rendered by scripts/backup/render-conf.sh from the
# environment (§14.4: environment variables only, no config file editing).
# NEVER hand-edit the rendered file: the next render overwrites it, and a
# hand-edit is invisible to the gate that checks the rendering is current.
#
# Placeholders are variable names wrapped in at-signs, substituted from the
# host's 0600 env file by render-conf.sh.
# No real hostname, path or bucket appears in this template — that is what
# gate-notopology enforces (§3.7).

[global]
repo1-type=@PGBACKREST_REPO_TYPE@
repo1-path=@PGBACKREST_REPO_PATH@
# ADR-010: encryption is set when the stanza is CREATED and cannot be changed
# afterwards. Changing it means a new stanza and a full backup.
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=@PGBACKREST_CIPHER_PASS@
# §14.2: 30 days of WAL.
repo1-retention-archive-type=incr
repo1-retention-archive=30
repo1-retention-full-type=time
repo1-retention-full=30
# Continuous WAL archiving; async keeps archive_command from blocking commits.
archive-async=y
spool-path=@PGBACKREST_SPOOL_PATH@
process-max=@PGBACKREST_PROCESS_MAX@
log-level-console=info
log-level-file=detail
start-fast=y

[@PGBACKREST_STANZA@]
pg1-path=@PGBACKREST_PG1_PATH@
pg1-port=@PGBACKREST_PG1_PORT@
pg1-user=@PGBACKREST_PG1_USER@
