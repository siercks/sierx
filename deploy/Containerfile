# Supply immutable toolchain images through scripts/release-image.sh.
ARG NODE_IMAGE
ARG GO_IMAGE
FROM --platform=$BUILDPLATFORM ${NODE_IMAGE} AS frontend
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS compile
ARG TARGETARCH
WORKDIR /src
COPY . .
COPY --from=frontend /src/web/dist ./web/dist
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -mod=vendor -trimpath -o /out/sierx ./cmd/sierx && \
    CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -mod=vendor -trimpath -o /out/sierxctl ./cmd/sierxctl

FROM scratch
COPY --from=compile /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=compile /out/sierx /usr/local/bin/sierx
COPY --from=compile /out/sierxctl /usr/local/bin/sierxctl
COPY --from=frontend /src/web/dist/assets /srv/sierx/assets
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/sierx"]
