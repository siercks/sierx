# sierx — one restore-test run, driven by sierx-restoretest.timer.
#
# Calls `sierxctl restore-test`, which calls the driver's restore-to verb and
# nothing else, rotating across the configured drivers so a secondary that has
# never been restored from cannot stay untested (ADR-010). No --force or
# --dry-run exists to pass here, by design.
[Unit]
Description=sierx restore test run
After=sierx-postgres.service
Requires=sierx-postgres.service

[Service]
Type=oneshot
ExecStart=/usr/bin/podman exec sierx sierxctl restore-test
# A failed restore test must be loud: it is the only evidence that the backups
# are real. journald plus a nonzero exit is what the host's own alerting reads.
StandardOutput=journal
StandardError=journal
