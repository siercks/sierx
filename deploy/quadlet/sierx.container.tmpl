[Unit]
Description=Sierx backlog
After=network-online.target sierx-postgres.service

[Container]
Image=@SIERX_IMAGE@
Pull=never
ContainerName=sierx
Network=host
UserNS=keep-id:uid=65532,gid=65532
Volume=%h/.local/share/sierx/lifecycle/guard:/var/lib/sierx/lifecycle/guard:ro,z
EnvironmentFile=%h/.config/sierx/app.env
ReadOnly=true
NoNewPrivileges=true

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=default.target
