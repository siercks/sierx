# sierx — one-shot partition maintenance, driven by sierx-maintenance.timer.
# Runs the partition command with its separate, narrowly privileged database URL.
[Unit]
Description=sierx partition maintenance run
After=sierx.service
Requires=sierx.service

[Service]
Type=oneshot
ExecStart=/usr/bin/podman exec --env-file %h/.config/sierx/maintenance.env sierx /usr/local/bin/sierxctl partitions ensure --months-ahead 1
