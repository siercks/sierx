# sierx — scheduled restore test (§14.2, ADR-017). "If the restore test has
# never run green, there is no backup."
#
# Weekly rather than daily: a restore of a full dump is the heaviest scheduled
# operation on the box, and §14.2 asks for weekly dumps. The randomized delay
# keeps it off the hour.
[Unit]
Description=sierx scheduled restore test

[Timer]
OnCalendar=Sun 03:00
RandomizedDelaySec=2h
Persistent=true

[Install]
WantedBy=timers.target
