[Unit]
Description=Sierx verified off-machine backup
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/sierx/backup.env
WorkingDirectory=@SIERX_CHECKOUT@
ExecStart=/usr/bin/flock -n %h/.local/share/sierx/backup.lock /bin/bash "@SIERX_CHECKOUT@/scripts/backup/run.sh"
TimeoutStartSec=2h
