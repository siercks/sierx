# Connected preparation only. This test OS is never a shipped application image.
ARG HOST_IMAGE
ARG NODE_IMAGE
FROM ${NODE_IMAGE} AS node
# Build against the existing Debian browser-tooling base, keeping the pinned
# decoder independent of newer Rocky development headers. Both guest runtimes
# are checked against the resulting binary and its exact receipt.
FROM ${NODE_IMAGE} AS tracer
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential patch python3 curl ca-certificates xz-utils
WORKDIR /build
COPY offline_guest_tracer.py termination-fix.json ./
RUN curl -fsSL https://github.com/strace/strace/releases/download/v6.8/strace-6.8.tar.xz -o strace-6.8.tar.xz && \
    python3 -B offline_guest_tracer.py --archive strace-6.8.tar.xz --patch termination-fix.json --output /out
FROM ${HOST_IMAGE}
USER root
COPY --from=node /usr/local/bin/ /usr/local/bin/
COPY --from=node /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
RUN printf 'SIERX_HOST_BUILD_STAGE: os-packages\n' && if command -v apt-get >/dev/null; then \
      apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        systemd dbus podman uidmap slirp4netns iproute2 procps python3 curl ca-certificates \
        openssl strace gnupg lsb-release && \
      install -d /usr/share/postgresql-common/pgdg && \
      curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc && \
      echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" > /etc/apt/sources.list.d/pgdg.list && \
      printf 'SIERX_HOST_BUILD_STAGE: postgres-client\n' && \
      apt-get update && apt-get install -y --no-install-recommends postgresql-client-18; \
    else \
      dnf install -y systemd dbus-daemon podman shadow-utils slirp4netns iproute procps-ng \
        python3 curl-minimal ca-certificates openssl strace \
        alsa-lib atk at-spi2-atk at-spi2-core cups-libs libdrm gtk3 libX11 libXcomposite \
        libXdamage libXext libXfixes libXrandr libxcb libxkbcommon mesa-libgbm nss nspr \
        pango cairo dbus-libs libXt liberation-fonts && \
      printf 'SIERX_HOST_BUILD_STAGE: postgres-client\n' && \
      dnf install -y "https://download.postgresql.org/pub/repos/yum/reporpms/EL-10-$(uname -m)/pgdg-redhat-repo-latest.noarch.rpm" && \
      dnf install -y postgresql18; \
    fi
# Use the same narrow, source-pinned termination correction on every guest.
# The source builder and compiler remain outside the exported acceptance OS.
COPY --from=tracer /out/strace /usr/bin/strace
COPY --from=tracer /out/tracer.json /usr/share/sierx-offline/tracer.json
WORKDIR /opt/acceptance
COPY package.json package-lock.json ./
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
RUN printf 'SIERX_HOST_BUILD_STAGE: npm-dependencies\n' && npm ci && \
    printf 'SIERX_HOST_BUILD_STAGE: browser-install\n' && if command -v apt-get >/dev/null; then \
      node node_modules/playwright/cli.js install --with-deps chromium firefox; \
    else node node_modules/playwright/cli.js install chromium firefox; fi && \
    rm -rf /root/.npm /root/.cache /var/cache/dnf /var/lib/apt/lists/*
RUN printf 'SIERX_HOST_BUILD_STAGE: certificate-tools\n' && if command -v apt-get >/dev/null; then apt-get update && apt-get install -y --no-install-recommends libnss3-tools && rm -rf /var/lib/apt/lists/*; else dnf install -y nss-tools && dnf clean all; fi
RUN printf 'SIERX_HOST_BUILD_STAGE: guest-kernel\n' && if command -v apt-get >/dev/null; then \
      apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends linux-image-virtual initramfs-tools && \
      rm -rf /var/lib/apt/lists/*; \
    else dnf install -y kernel-core kernel-modules dracut && \
      version=$(basename /lib/modules/*) && \
      install -m 0644 "/lib/modules/$version/vmlinuz" "/boot/vmlinuz-$version" && \
      dracut --force --no-hostonly --kver "$version" && dnf clean all; fi
# Keep the normal UID/GID mapping-helper privilege mechanism portable across
# rootless OCI export and ext4 population, which do not retain file capabilities.
RUN printf 'SIERX_HOST_BUILD_STAGE: uid-mapping\n' && chmod 4755 /usr/bin/newuidmap /usr/bin/newgidmap
ENTRYPOINT ["/usr/lib/systemd/systemd"]
